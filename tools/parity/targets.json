{
  "ac.h1": { "target": "main header h1" },
  "ac.search.form": { "target": "form[role=search]", "fixedSize": true },
  "ac.search.input": { "target": "#category-search", "fixedSize": true },
  "ac.search.btn": { "target": "form[role=search] button[type=submit]", "fixedSize": true },
  "ac.card": { "target": "main section ul > li > a", "all": true, "fixedSize": true },
  "pc.h1": { "target": "main header h1" },
  "pc.pill.save": { "target": "main header a[href=\"/login\"], main header button:has-text(\"Save Search\")", "fixedSize": true },
  "pc.aside": { "target": "aside[aria-label=Filter]" },
  "pc.card": { "target": "main section ul > li > article", "all": true },
  "pc.subcat": { "target": "main section ul > li > a", "all": true },
  "ca.h1": { "target": "main header h1" },
  "ca.aside": { "target": "aside[aria-label=Filter]", "fixedSize": true },
  "ca.toolbar": { "target": "main div.mb-8" },
  "ca.sort": { "target": "main select" },
  "ca.viewToggle": { "target": "div[role=group]" },
  "ca.list.card": { "target": "ul[aria-label] > li", "all": true },
  "product.gallery": { "target": "section[aria-label^=\"Photos of\"]", "fixedSize": true },
  "product.title-card": { "target": "main section.border:nth-of-type(1)" },
  "product.seller-card": { "target": "section[aria-label=Seller]" },
  "product.ad-meta-card": { "target": "section[aria-label=\"Ad details\"]" },
  "product.buy-now": { "target": "aside a:has-text(\"Buy Now\")", "fixedSize": true },
  "product.make-offer": { "target": "aside a:has-text(\"Make an Offer\")", "fixedSize": true },
  "product.send-message": { "target": "aside button:has-text(\"Send Message\")", "fixedSize": true },
  "product.share": { "target": "button:text-is(\"Share Ad\")", "fixedSize": true },
  "product.report": { "target": "button:text-is(\"Report Ad\")", "fixedSize": true },
  "product.more-card": { "target": "section.mt-8 ul > li > article", "all": true },
  "product.view-all": { "target": "section.mt-8 a:has-text(\"View all\")" }
}
