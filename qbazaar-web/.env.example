# QBazaar web — local dev env (copy to .env.local)

# API origin used by the browser and the server. http://localhost:8000 for the
# real backend, http://localhost:4010 for the Prism mock
# (cd ../qbazaar-contracts && npm run mock).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-only API origin for the refresh-cookie route handlers, for
# when the Next.js server reaches the API by another address than the browser.
# Falls back to NEXT_PUBLIC_API_URL; leave it commented out unless needed,
# because an empty value counts as set.
# QBAZAAR_API_URL=http://127.0.0.1:8000

# Public origin of this site: canonical, Open Graph, robots and sitemap URLs.
# Production: https://qbazaar.qa
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reverb (WebSocket) — only needed from Sprint 8 onwards
NEXT_PUBLIC_REVERB_APP_KEY=local-dev-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Firebase Cloud Messaging (web push) — all five values come from the
# Firebase console (Project settings → General + Cloud Messaging). Web push
# stays disabled while these are empty: the enable button is hidden, the
# service worker is never registered and the firebase SDK is never loaded.
NEXT_PUBLIC_FCM_API_KEY=
NEXT_PUBLIC_FCM_PROJECT_ID=
NEXT_PUBLIC_FCM_SENDER_ID=
NEXT_PUBLIC_FCM_APP_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=

# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile → widget).
# Leave empty to disable: no widget is rendered and no X-Turnstile-Token header
# is sent. Set it before turning on TURNSTILE_ENABLED on the API, whose
# TURNSTILE_SECRET_KEY must belong to the same widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
