APP_NAME=QBazaar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://qbazaar-api.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_QA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qbazaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@qbazaar.qa"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=qbazaar
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# When set, every issued OTP equals this value (Twilio/log channel still runs).
# Leave UNSET in production — a non-empty value is a security risk.
OTP_FIXED_CODE=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+974

# Firebase service-account JSON for web push (kreait/laravel-firebase canonical
# name; project id lives inside the JSON). Relative paths resolve against the
# project root. Leave UNSET to disable push — notifications skip the FCM channel.
FIREBASE_CREDENTIALS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Media storage. Local dev keeps files on the `public` disk. Set MEDIA_DISK=r2
# and MEDIA_PUBLIC_DISK=r2_public (plus the R2_* keys) to store ad images,
# avatars and their thumbnails on Cloudflare R2, then run
# `php artisan media:migrate-storage --dry-run` and without --dry-run.
MEDIA_DISK=public
MEDIA_PUBLIC_DISK=public

# Cloudflare R2 (S3 API). Endpoint: https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET keeps private originals (served through presigned links);
# R2_PUBLIC_BUCKET has public access or a custom domain set to R2_PUBLIC_URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# Cloudflare Turnstile on every public endpoint that sends an email or SMS
# (header X-Turnstile-Token).
# The site key goes to the web/mobile apps; only the secret lives here.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Sign-in (M1). Turn the new-device SMS check on only once Twilio
# credentials are live.
AUTH_NEW_DEVICE_CHECK_ENABLED=false
# Password sign-in stays on while clients move to email codes.
AUTH_PASSWORD_LOGIN_ENABLED=true
# Comma-separated OAuth client ids accepted as the id_token audience.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

TELESCOPE_ENABLED=true

# Comma-separated browser origins allowed to call the API (defaults to WEB_URL).
# CORS_ALLOWED_ORIGINS=https://qbazaar.qa,https://www.qbazaar.qa
# Swagger UI and /api/v1/openapi.yaml; off in production unless true.
# API_DOCS_ENABLED=true

# Days kept by the nightly pruning (deploy/README.md, "Data retention").
# ACTIVITY_LOG_RETENTION_DAYS=365
# READ_NOTIFICATIONS_RETENTION_DAYS=90
