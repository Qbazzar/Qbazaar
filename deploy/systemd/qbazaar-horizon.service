# QBazaar Horizon (queue workers) — systemd unit
# Runs one supervisor per queue: realtime, notifications, default, search,
# media, low (see deploy/README.md "Queues").
# Install (as root):
#   cp deploy/systemd/qbazaar-horizon.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now qbazaar-horizon
#
# PHP path: adjust if EA-PHP 8.4 lives elsewhere (verify with:
#   /opt/cpanel/ea-php84/root/usr/bin/php -v   # must be 8.4
# Requires ext-pcntl + ext-posix in the ea-php84 CLI build.
[Unit]
Description=QBazaar Horizon (queues)
After=network.target redis.service mysqld.service

[Service]
Type=simple
User=qbazaar
Group=qbazaar
WorkingDirectory=/home/qbazaar/qbazaar/qbazaar-api
ExecStart=/opt/cpanel/ea-php84/root/usr/bin/php /home/qbazaar/qbazaar/qbazaar-api/artisan horizon
ExecStop=/opt/cpanel/ea-php84/root/usr/bin/php /home/qbazaar/qbazaar/qbazaar-api/artisan horizon:terminate
Restart=always
RestartSec=5
# Lets a running image conversion (300 s timeout) finish on restart. A longer
# low-queue sweep is stopped and picked up again after its retry_after.
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
