# QBazaar Reverb (websockets) — systemd unit
# Listens on 127.0.0.1:8080; Apache proxies wss://<API_HOST>/app
# to it. The Laravel app PUBLISHES events to it on localhost (REVERB_HOST=
# 127.0.0.1 in qbazaar-api/.env) — the public host is for the browser only.
# Install (as root):
#   cp deploy/systemd/qbazaar-reverb.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now qbazaar-reverb
[Unit]
Description=QBazaar Reverb (websockets)
After=network.target redis.service

[Service]
Type=simple
User=qbazaar
Group=qbazaar
WorkingDirectory=/home/qbazaar/qbazaar/qbazaar-api
ExecStart=/opt/cpanel/ea-php84/root/usr/bin/php /home/qbazaar/qbazaar/qbazaar-api/artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5
# OPS-18.14: one file descriptor per open socket. The default 1024 refuses
# connections after about a thousand. Above ~1000 sockets Reverb also needs
# an event-loop extension (uv, ev or event): its default stream_select loop
# is capped at 1024 whatever this says (deploy/README.md "Reverb capacity").
LimitNOFILE=65535
# Chat latency matters more than batch work on a busy box.
Nice=-2

[Install]
WantedBy=multi-user.target
