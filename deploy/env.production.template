# QBazaar API — production .env template (api.qbazaar.fleeteye.de · user fleeteye).
#
# Copy to /home/fleeteye/qbazaar/qbazaar-api/.env on the server, then:
#   php artisan key:generate
# and fill every __FILL_ME__.

APP_NAME=QBazaar
APP_ENV=production
APP_KEY=
# On a key rotation put the old key here so refresh tokens (HMAC-keyed by
# APP_KEY) keep working until they expire.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api.qbazaar.fleeteye.de

# Deep links in mailed/push notifications point at the FRONTEND, not the API.
WEB_URL=https://qbazaar.fleeteye.de
# Browser origins allowed by CORS (comma-separated); defaults to WEB_URL.
CORS_ALLOWED_ORIGINS=https://qbazaar.fleeteye.de
# Swagger UI + /api/v1/openapi.yaml stay hidden in production unless true.
API_DOCS_ENABLED=false

# Trusted reverse proxies. Empty means Cloudflare's published ranges
# (config/trustedproxy.php); set a comma-separated list for another proxy.
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_QA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__FILL_ME__
DB_USERNAME=__FILL_ME__
DB_PASSWORD=__FILL_ME__

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Seconds before a job whose worker died is run again. Must stay above the
# longest timeout on that connection: 120 s (redis) and 1800 s (redis-long).
REDIS_QUEUE_RETRY_AFTER=150
REDIS_LONG_QUEUE_RETRY_AFTER=1900
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# REQUIRED on a shared/WHM box — the `requirepass` from /etc/redis/redis.conf.
REDIS_PASSWORD=__FILL_ME__
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Ad views are buffered on the `default` Redis connection (never the evictable
# cache DB) and written to MySQL every minute by `ads.flush-view-counts`.
# `database` writes each view directly (local setups without Redis).
AD_VIEWS_BUFFER=redis

MAIL_MAILER=smtp
MAIL_HOST=__FILL_ME__
MAIL_PORT=587
MAIL_USERNAME=__FILL_ME__
MAIL_PASSWORD=__FILL_ME__
MAIL_FROM_ADDRESS="no-reply@qbazaar.fleeteye.de"
MAIL_FROM_NAME="${APP_NAME}"

# Search runs on Meilisearch only (install: deploy/README.md). The search
# queries rely on Meili filters/facets, so other Scout drivers are unsupported.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=__FILL_ME__

# Reverb: the app PUBLISHES to the local server (127.0.0.1:8080); the BROWSER
# connects to wss://api.qbazaar.fleeteye.de/app via the Apache proxy (those
# public values live in qbazaar-web/.env.production, not here).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=qbazaar
REVERB_APP_KEY=__FILL_ME__
REVERB_APP_SECRET=__FILL_ME__
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Leave UNSET in production. Setting this is a security risk.
OTP_FIXED_CODE=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+974

# FCM web push — empty disables push cleanly. Path resolves against base_path().
FIREBASE_CREDENTIALS=

# Media storage — Cloudflare R2. Until the R2 keys exist keep both on `public`.
# Switch-over: fill the R2_* values, set MEDIA_DISK=r2 and
# MEDIA_PUBLIC_DISK=r2_public, `php artisan config:cache`, then
# `php artisan media:migrate-storage --dry-run` followed by
# `php artisan media:migrate-storage` (safe to re-run; local files are kept).
MEDIA_DISK=public
MEDIA_PUBLIC_DISK=public
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Private bucket: full-resolution originals, served via short-lived presigned URLs.
R2_BUCKET=
# Public bucket (custom domain, e.g. https://media.qbazaar.qa): thumbnails + avatars.
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# Cloudflare Turnstile on register / send-otp / resend-otp. Turn on only after
# the web and mobile apps send X-Turnstile-Token (FE-16.9, MB-15.14).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

TELESCOPE_ENABLED=false

# Retention for the nightly pruning (deploy/README.md, "Data retention").
ACTIVITY_LOG_RETENTION_DAYS=365
READ_NOTIFICATIONS_RETENTION_DAYS=90
