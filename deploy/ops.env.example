# /etc/qbazaar/ops.env — settings for the root ops scripts (backup.sh,
# restore-test.sh, meili-restore-test.sh, mysql-slow-digest.sh), read through
# deploy/scripts/ops-common.sh. Install with mode 600, owner root.
#
# Names only; nothing secret belongs here. MariaDB credentials come from
# /root/.my.cnf (cPanel keeps it), the off-site and R2 credentials from
# /root/.config/rclone/rclone.conf (DOCS/M5-LAUNCH-RUNBOOK.md, step 9).
# Every key is optional; the values shown are the defaults.

REPO_DIR=/home/qbazaar/qbazaar
DB_NAME=qbazaar_app
# MYSQL_DEFAULTS_FILE=/root/.my.cnf

# Local copies (root 700) and how many days they stay.
BACKUP_DIR=/var/backups/qbazaar
BACKUP_KEEP_LOCAL_DAYS=7

# Off-site copies: an rclone path on a `crypt` remote, e.g. qbazaar-offsite:
# (the scripts refuse an unencrypted remote). Empty keeps everything on this
# server only, which does not survive losing the server.
BACKUP_OFFSITE=
BACKUP_OFFSITE_KEEP_DAILY_DAYS=14
BACKUP_OFFSITE_KEEP_MONTHLY_DAYS=365

# Media to mirror off-site, space separated rclone paths, e.g. the two R2
# buckets through a read-only R2 token: r2:<R2_BUCKET> r2:<R2_PUBLIC_BUCKET>.
# The API's storage/app is always added.
BACKUP_MEDIA_SOURCES=
BACKUP_MEDIA_DELETED_KEEP_DAYS=30
BACKUP_MEDIA_MAX_DELETE=5000

# Dead-man's switches (Healthchecks.io or a Better Stack heartbeat). Pinged
# after a good run; <url>/fail after a failed one. The monitor alerts when a
# ping is late, so a backup that never started is caught too.
BACKUP_HEARTBEAT_URL=
RESTORE_HEARTBEAT_URL=

# restore-test.sh loads the dump into this scratch database and drops it.
RESTORE_DB=qbazaar_restoretest

# mysql-slow-digest.sh
SLOW_LOG=/var/lib/mysql/qbazaar-slow.log
DIGEST_DIR=/var/log/qbazaar/slow-digest
DIGEST_KEEP_WEEKS=12
DIGEST_MAILTO=
